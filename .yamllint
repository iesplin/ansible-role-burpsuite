---
extends: default

ignore: |
  .venv/

rules:
  braces:
    max-spaces-inside: 1
    level: error
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  brackets:
    max-spaces-inside: 1
    level: error
  line-length:
    max: 180
    level: warning
  indentation:
    indent-sequences: consistent
    level: warning
  truthy:
    check-keys: false
